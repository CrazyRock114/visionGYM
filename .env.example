# Copy to `.env` and fill in your key — once, here at the repo root:
#     cp .env.example .env
#
# Every project in this repo finds it: the loader walks up from the project
# directory to the nearest `.env`, so one file serves all of them.
#
# Get one at https://app.vlm.run — Settings -> API keys.
# `.env` is gitignored. An exported VLMRUN_API_KEY overrides this file.
VLMRUN_API_KEY=
